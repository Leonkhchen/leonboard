{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leon-project-control-center",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leonboard-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
