{
  "name": "LeonBoard Cloud Dev",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y curl jq sqlite3 && npm ci && npm install -g opencode-ai",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "Cloudflare Worker Dev",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "remoteUser": "node"
}
